#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

PROJECT_NUMBER=12
PROJECT_OWNER="ropensci"
SNAPSHOT_LIMIT=2000

DRY_RUN=0
if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--dry-run" ]; }; then
  echo "Usage: $0 [--dry-run]"
  echo "  no args    report, then add missing open issues/PRs to the board"
  echo "  --dry-run  report only"
  exit 1
fi
if [ "$#" -eq 1 ]; then
  DRY_RUN=1
fi
export DRY_RUN

snapshot=$(mktemp)
trap 'rm -f "$snapshot"' EXIT

board=$(gh project item-list "${PROJECT_NUMBER}" --owner "${PROJECT_OWNER}" -L "${SNAPSHOT_LIMIT}" --format json)

if [ "$(jq '.items | length' <<<"$board")" -ge "${SNAPSHOT_LIMIT}" ]; then
  echo "Snapshot limit of ${SNAPSHOT_LIMIT} items reached; project ${PROJECT_NUMBER} may be truncated. Aborting."
  exit 1
fi

jq -r '.items[] | select(.content.url != null) | .content.url' <<<"$board" | sort -u > "$snapshot"
repos=$(jq -r '.items[] | select(.content.repository != null) | .content.repository' <<<"$board" | sort -u)

added_issues=0
added_prs=0

while read -r repo; do
  [ -n "$repo" ] || continue
  issues=$(gh issue list --repo "$repo" --state open --limit 1000 --json url --jq '.[].url')
  prs=$(gh pr list --repo "$repo" --state open --limit 1000 --json url --jq '.[].url')
  open=$(printf '%s\n%s\n' "$issues" "$prs" | grep . | sort -u || true)
  to_add=$(printf '%s\n' "$open" | grep -vxF -f "$snapshot" | grep . || true)

  open_n=$(printf '%s\n' "$open" | grep -c . || true)
  to_add_n=$(printf '%s\n' "$to_add" | grep -c . || true)
  printf '%s: %d open, %d on board, %d to add\n' "$repo" "$open_n" "$((open_n - to_add_n))" "$to_add_n"
  if [ "$to_add_n" -gt 0 ]; then
    printf '%s\n' "$to_add" | sed 's/^/  /'
  fi
  if [ "$to_add_n" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
    while read -r url; do
      [ -n "$url" ] || continue
      gh project item-add "$PROJECT_NUMBER" --owner "$PROJECT_OWNER" --url "$url" </dev/null
      case "$url" in
        */pull/*) added_prs=$((added_prs + 1)) ;;
        *) added_issues=$((added_issues + 1)) ;;
      esac
    done < <(printf '%s\n' "$to_add")
  fi
done <<<"$repos"

printf 'Added %d issues and %d PRs\n' "$added_issues" "$added_prs"
