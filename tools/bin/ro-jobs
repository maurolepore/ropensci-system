#!/usr/bin/env bash

# Run every routine job as one sweep, e.g. a morning check.
# Each job runs for real; a failing job does not stop the remaining jobs.
# Exit status is non-zero if any job failed, so a scheduler can alert.

# Exit on unset variables only; failures are handled per job below
set -u

JOBS=(
  ro-bot-alert-if-down
  ro-project-sync
)

failed=()
added_issues=0
added_prs=0

for job in "${JOBS[@]}"; do
  printf '\n==> %s\n' "$job"
  if ! command -v "$job" >/dev/null 2>&1; then
    printf '<== %s: not found\n' "$job"
    failed+=("$job")
    continue
  fi
  if out=$("$job" 2>&1); then
    printf '%s\n' "$out"
    printf '<== %s: OK\n' "$job"
    if [ "$job" = "ro-project-sync" ] &&
       counts=$(printf '%s\n' "$out" | grep '^Added ' | sed -E 's/^Added ([0-9]+) issues? and ([0-9]+) PRs?$/\1 \2/'); then
      added_issues=${counts%% *}
      added_prs=${counts##* }
    fi
  else
    printf '%s\n' "$out"
    printf '<== %s: FAILED\n' "$job"
    failed+=("$job")
  fi
done

if [ "${#failed[@]}" -gt 0 ]; then
  printf '\nFailed: %s\n' "${failed[*]}"
  printf '\nsystem DOWN | added %d issues and %d PRs\n' "$added_issues" "$added_prs"
  exit 1
fi

printf '\nAll %d jobs OK\n' "${#JOBS[@]}"
printf '\nsystem OK | added %d issues and %d PRs\n' "$added_issues" "$added_prs"
