#!/usr/bin/env Rapp
# | name: code-frequency
# | description: Generate a code frequency plot from piped addition/deletion data.

suppressPackageStartupMessages({
  library(ggplot2)
  library(dplyr)
  library(tidyr)
  library(readr)
  library(rappdirs)
})

# Read all lines from standard input (stdin) provided by the pipe
input_lines <- readLines(file("stdin"))

if (length(input_lines) == 0) {
  stop("No input data provided via pipe.", call. = FALSE)
}

data_raw <- paste(input_lines, collapse = "\n")

df <- read_tsv(I(data_raw), col_names = c("week", "additions", "deletions"), col_types = cols(.default = "c"), show_col_types = FALSE)

p <- df %>%
  mutate(
    additions = as.numeric(gsub("\\+", "", additions)),
    deletions = as.numeric(gsub("-", "", deletions)),
    date = as.Date(paste0(week, "-1"), format = "%Y-W%V-%u")
  ) %>%
  select(date, additions, deletions) %>%
  pivot_longer(cols = c(additions, deletions), names_to = "type", values_to = "lines") %>%
  mutate(
    type = factor(type, levels = c("additions", "deletions"), labels = c("Additions", "Deletions")),
    lines_plottable = ifelse(type == "Deletions", -lines, lines)
  ) %>%
  ggplot(aes(x = date, y = lines_plottable, fill = type)) +
  geom_col(width = 5) +
  scale_fill_manual(values = c("Additions" = "#2cbe4e", "Deletions" = "#cb2431")) +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid.major.x = element_line(color = "#eaecef", linetype = "dashed"),
    panel.grid.minor.x = element_blank(),
    panel.grid.major.y = element_line(color = "#eaecef", linetype = "dashed"),
    panel.grid.minor.y = element_blank(),
    panel.background = element_rect(fill = "white", color = NA),
    plot.background = element_rect(fill = "white", color = NA),
    legend.position = "right",
    legend.title = element_blank(),
    plot.title = element_text(face = "bold", size = 16),
    plot.subtitle = element_text(color = "#586069", size = 11)
  ) +
  labs(
    title = "Code frequency",
    subtitle = "Additions and deletions per week",
    x = NULL,
    y = NULL
  )

# Use user cache dir handled by rappdirs for OS-appropriate temporary storage
tmp_dir <- rappdirs::user_cache_dir("ro-plot-code-frequency")
dir.create(tmp_dir, showWarnings = FALSE, recursive = TRUE)
out_file <- file.path(tmp_dir, "code-frequency.png")

# Save the plot
ggsave(out_file, plot = p, width = 10, height = 5, dpi = 300)

# Print the path to stdout so it's fully pipe-compatible
cat(out_file, "\n")

